{
  "name": "golang-gherkingen",
  "displayName": "Golang - BDD (gherkin) generator",
  "description": "Behaviour Driven Development (BDD) tests boilerplate generator for Golang.",
  "version": "1.0.3",
  "engines": {
    "vscode": "^1.78.0"
  },
  "homepage": "https://github.com/hedhyw/vscode-golang-gherkingen",
  "repository": {
    "type": "git",
    "url": "https://github.com/hedhyw/vscode-golang-gherkingen"
  },
  "bugs": {
    "url": "https://github.com/hedhyw/vscode-golang-gherkingen/issues"
  },
  "icon": "assets/icon.png",
  "license": "MIT",
  "publisher": "hedhyw",
  "keywords": [
    "go",
    "golang",
    "boilerplate",
    "generator",
    "test",
    "bdd",
    "bdd-style",
    "gherkin",
    "cucumber",
    "behavior-driven-development",
    "golang-library",
    "golang-package",
    "bdd-framework",
    "bdd-tests",
    "bdd-style-testing-framework",
    "cucumber-gherkin",
    "gherkingen"
  ],
  "categories": [
    "Programming Languages"
  ],
  "author": "Maksym Kryvchun",
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "feature",
        "aliases": [
          "feature",
          "gherkin",
          "Gherkin",
          "cucumber"
        ],
        "extensions": [
          ".feature",
          ".testcase"
        ]
      }
    ],
    "commands": [
      {
        "command": "golang-gherkingen.generate",
        "title": "Generate BDD Golang test",
        "category": "Go",
        "icon": "$(bracket)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "golang-gherkingen.generate",
          "group": "3_open",
          "when": "resourceLangId == 'feature'"
        }
      ]
    },
    "configuration": [
      {
        "title": "golang-gherkingen",
        "properties": {
          "golang-gherkingen.feature.language": {
            "type": [
              "string"
            ],
            "default": "not specified",
            "enum": [
              "af",
              "am",
              "amh",
              "an",
              "ar",
              "ast",
              "az",
              "be",
              "bg",
              "bm",
              "bs",
              "ca",
              "cs",
              "cy-GB",
              "da",
              "de",
              "el",
              "em",
              "en",
              "en-Scouse",
              "en-au",
              "en-lol",
              "en-old",
              "en-pirate",
              "en-tx",
              "eo",
              "es",
              "et",
              "fa",
              "fi",
              "fr",
              "ga",
              "gj",
              "gl",
              "he",
              "hi",
              "hr",
              "ht",
              "hu",
              "id",
              "is",
              "it",
              "ja",
              "jv",
              "ka",
              "kn",
              "ko",
              "lt",
              "lu",
              "lv",
              "mk-Cyrl",
              "mk-Latn",
              "ml",
              "mn",
              "mr",
              "ne",
              "nl",
              "no",
              "pa",
              "pl",
              "pt",
              "ro",
              "ru",
              "sk",
              "sl",
              "sr-Cyrl",
              "sr-Latn",
              "sv",
              "ta",
              "te",
              "th",
              "tlh",
              "tr",
              "tt",
              "uk",
              "ur",
              "uz",
              "vi",
              "zh-CN",
              "zh-TW"
            ],
            "enumItemLabels": [
              "Afrikaans\tAfrikaans",
              "Armenian\tհայերեն",
              "Amharic\tአማርኛ",
              "Aragonese\tAragonés",
              "Arabic\tالعربية",
              "Asturian\tasturianu",
              "Azerbaijani\tAzərbaycanca",
              "Belarusian\tБеларуская",
              "Bulgarian\tбългарски",
              "Malay\tBahasa Melayu",
              "Bosnian\tBosanski",
              "Catalan\tcatalà",
