              "Thai\tไทย",
              "Klingon\ttlhIngan",
              "Turkish\tTürkçe",
              "Tatar\tТатарча",
              "Ukrainian\tУкраїнська",
              "Urdu\tاردو",
              "Uzbek\tУзбекча",
              "Vietnamese\tTiếng Việt",
              "Chinese simplified\t简体中文",
              "Chinese traditional\t繁體中文"
            ],
            "description": "The natural language used to describe the feature.\n\nThis parameter is optional if language information is included in the feature file name, or if the feature is written in English (en).\nThe file name should be formatted as follows: <description>.<language_hint>.feature if language hint is included, or <description>.feature if it is not.\n\nWhen specified, this parameter takes precedence over the language hint from the file name."
          }
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.0",
    "@types/vscode": "1.78.1",
    "@vscode/test-electron": "^3.1.0",
    "eslint": "^10.8.0",
    "glob": "^13.0.6",
    "mocha": "^11.7.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  },
  "overrides": {
    "diff": "^9.0.0",
    "minimatch": "^10.2.6",
    "serialize-javascript": "^7.0.5"
  }
}