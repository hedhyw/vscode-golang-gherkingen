              "Lithuanian\tlietuvių kalba",
              "Luxemburgish\tLëtzebuergesch",
              "Latvian\tlatviešu",
              "Macedonian\tМакедонски",
              "Macedonian (Latin)\tMakedonski (Latinica)",
              "Malayalam\tമലയാളം",
              "Mongolian\tмонгол",
              "Marathi\tमराठी",
              "Nepali\tनेपाली",
              "Dutch\tNederlands",
              "Norwegian\tnorsk",
              "Panjabi\tਪੰਜਾਬੀ",
              "Polish\tpolski",
              "Portuguese\tportuguês",
              "Romanian\tromână",
              "Russian\tрусский",
              "Slovak\tSlovensky",
